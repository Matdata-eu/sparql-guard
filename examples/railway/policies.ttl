# Access roles for the railway playground. Edit this file while the compose stack runs:
# the proxy reloads it within a few seconds (a broken file keeps the previous version active).

@prefix sg:  <https://matdata.eu/ns/sparql-guard#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix rv:  <https://example.org/rail/vocab#> .
@prefix rd:  <https://example.org/rail/data/> .
@prefix pol: <https://example.org/rail/policy/> .


# ---------------------------------------------------------------------------
# Everyone, also without credentials: the public network description.
# ---------------------------------------------------------------------------
pol:public a sg:Policy ;
  sg:agent sg:Anyone ;
  sg:readGraph <https://example.org/rail/graph/network> .

# ---------------------------------------------------------------------------
# A railway undertaking sees the timetable, but only its own train paths.
# ---------------------------------------------------------------------------
pol:operator-acme a sg:Policy ;
  sg:group "operator-acme" ;
  sg:readGraph <https://example.org/rail/graph/network>, <https://example.org/rail/graph/timetable> ;
  sg:visibleIf pol:AcmeTrainPathsOnly .

pol:AcmeTrainPathsOnly a sh:NodeShape ;
  sh:targetClass rv:TrainPath ;
  sh:property [ sh:path rv:operatedBy ; sh:hasValue rd:acme-rail ] .

# ---------------------------------------------------------------------------
# Maintenance teams see assets and work orders of their own region, and the staff of their
# region plus their own staff record. Nobody in maintenance sees salary scales.
# ---------------------------------------------------------------------------
pol:maintenance-north a sg:Policy ;
  sg:group "maintenance-north" ;
  sg:readGraph <https://example.org/rail/graph/network>, <https://example.org/rail/graph/assets>,
    <https://example.org/rail/graph/maintenance>, <https://example.org/rail/graph/staff> ;
  sg:visibleIf pol:NorthAssets, pol:NorthWorkOrders, pol:NorthStaffOrMyself ;
  sg:hideProperties pol:NoSalaryScales .

pol:NorthAssets a sh:NodeShape ;
  sh:targetClass rv:Asset ;
  sh:property [ sh:path rv:region ; sh:hasValue rd:region-north ] .

pol:NorthWorkOrders a sh:NodeShape ;
  sh:targetClass rv:WorkOrder ;
  sh:property [ sh:path rv:region ; sh:hasValue rd:region-north ] .

pol:NorthStaffOrMyself a sh:NodeShape ;
  sh:targetClass rv:Staff ;
  sh:or (
    [ sh:property [ sh:path rv:team ; sh:hasValue rd:region-north ] ]
    [ sh:property [ sh:path rv:account ; sh:hasValue sg:requestingAgent ] ]
  ) .

pol:maintenance-south a sg:Policy ;
  sg:group "maintenance-south" ;
  sg:readGraph <https://example.org/rail/graph/network>, <https://example.org/rail/graph/assets>,
    <https://example.org/rail/graph/maintenance>, <https://example.org/rail/graph/staff> ;
  sg:visibleIf pol:SouthAssets, pol:SouthWorkOrders, pol:SouthStaffOrMyself ;
  sg:hideProperties pol:NoSalaryScales .

pol:SouthAssets a sh:NodeShape ;
  sh:targetClass rv:Asset ;
  sh:property [ sh:path rv:region ; sh:hasValue rd:region-south ] .

pol:SouthWorkOrders a sh:NodeShape ;
  sh:targetClass rv:WorkOrder ;
  sh:property [ sh:path rv:region ; sh:hasValue rd:region-south ] .

pol:SouthStaffOrMyself a sh:NodeShape ;
  sh:targetClass rv:Staff ;
  sh:or (
    [ sh:property [ sh:path rv:team ; sh:hasValue rd:region-south ] ]
    [ sh:property [ sh:path rv:account ; sh:hasValue sg:requestingAgent ] ]
  ) .

pol:NoSalaryScales a sh:NodeShape ;
  sh:targetClass rv:Staff ;
  sh:property [ sh:path rv:salaryScale ] .

# ---------------------------------------------------------------------------
# Safety analysts see incidents, assets and the timetable, but not who was driving,
# what drivers stated, or the access codes of level crossing cabinets.
# ---------------------------------------------------------------------------
pol:safety a sg:Policy ;
  sg:group "safety" ;
  sg:readGraph <https://example.org/rail/graph/network>, <https://example.org/rail/graph/assets>,
    <https://example.org/rail/graph/incidents>, <https://example.org/rail/graph/timetable> ;
  sg:hideProperties pol:NoDriverData, pol:NoAccessCodes .

pol:NoDriverData a sh:NodeShape ;
  sh:targetClass rv:Incident ;
  sh:property [ sh:path rv:involvedDriver ], [ sh:path rv:driverStatement ] .

pol:NoAccessCodes a sh:NodeShape ;
  sh:targetClass rv:LevelCrossing ;
  sh:property [ sh:path rv:cabinetAccessCode ] .

# ---------------------------------------------------------------------------
# Administrators read everything. The graphs are listed rather than using
# sg:readAllGraphs, so that their default graph is the union of all of them.
# ---------------------------------------------------------------------------
pol:admin a sg:Policy ;
  sg:group "admin" ;
  sg:readGraph <https://example.org/rail/graph/network>, <https://example.org/rail/graph/assets>,
    <https://example.org/rail/graph/maintenance>, <https://example.org/rail/graph/timetable>,
    <https://example.org/rail/graph/incidents>, <https://example.org/rail/graph/staff> .
